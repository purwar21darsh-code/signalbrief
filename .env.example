# SignalBrief Environment Variables Configuration
# Production Database: PostgreSQL URL (e.g. postgresql://user:password@localhost:5432/signalbrief?schema=public)
# Local Zero-Config Database: SQLite URL
DATABASE_URL="file:./prisma/dev.db"

# Tavily Real-Time Web Research Engine
# Get an API key from https://tavily.com
TAVILY_API_KEY=""

# Bifrost by Maxim AI LLM Inference Gateway
# Official docs: https://docs.getbifrost.ai/
# Leave blank for Docker Compose (it uses http://bifrost:8080/v1).
# For direct Node development, set this to http://localhost:8080/v1.
# Or Maxim AI Cloud Gateway: https://api.getbifrost.ai/v1
BIFROST_BASE_URL=""
BIFROST_API_KEY=""
BIFROST_MODEL="openai/gpt-4o-mini"

# Application Base URL
APP_URL="http://localhost:3000"

# Optional: Set to "true" to force demo mode for public showcase or testing
FORCE_DEMO_MODE="false"
