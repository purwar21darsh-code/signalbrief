{
  "name": "signalbrief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate --schema=prisma/schema.prisma",
    "dev": "next dev",
    "prebuild": "prisma generate --schema=prisma/schema.prisma",
    "build": "next build",
    "build:postgres": "prisma generate --schema=prisma/schema.postgresql.prisma && next build",
    "vercel-build": "prisma generate --schema=prisma/schema.postgresql.prisma && next build",
    "start": "next start",
    "db:push": "prisma db push --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.prisma",
    "db:generate": "prisma generate",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.postgresql.prisma",
    "pretypecheck": "prisma generate --schema=prisma/schema.prisma",
    "typecheck": "tsc --noEmit",
    "pretest": "prisma generate --schema=prisma/schema.prisma && prisma db push --schema=prisma/schema.prisma",
    "test": "vitest run",
    "pretest:e2e": "node scripts/prepare-e2e.mjs",
    "test:e2e": "playwright test",
    "test:e2e:postgres": "playwright test --config=playwright.postgres.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.10",
    "lucide-react": "^0.454.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
